# =============================================================================
# TravelMind AI — Environment Variables
# Copy this file to .env in your root / frontend directory
# =============================================================================

# 1. Supabase Project Configuration (From your Supabase Project Settings > API)
# URL: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable / Anon API Key (Safe for frontend browsers with RLS enabled)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# 2. Local Backend Service URL
VITE_BACKEND_URL=http://localhost:8000
