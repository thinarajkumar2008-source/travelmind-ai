# =============================================================================
# TravelMind AI — Backend Server Environment Variables
# Copy this file to backend/.env for backend server configuration
# =============================================================================

ENVIRONMENT=development

# 1. Supabase Database & Auth Configuration
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key is PRIVATE and must only be used on the backend server!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL connection string (Project Settings > Database > Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# 2. AI Video Understanding & Concierge API
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google Maps & Places API (Optional - for live hotel/restaurant search)
# Get from: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 4. CORS Allowed Origins (Comma-separated origins for production frontend)
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.onrender.com

